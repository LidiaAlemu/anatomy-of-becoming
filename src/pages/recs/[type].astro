---
import BaseLayout from '../../layouts/BaseLayout.astro';
import recsFilters from '../../data/recsFilters.json';

const allRecs = await Astro.glob('../../content/recs/*.md');

function normalizeTypeKey(type) {
  if (!type) return '';
  const lower = type.toLowerCase();
  return lower.endsWith('s') ? lower.slice(0, -1) : lower;
}

const typeKey = normalizeTypeKey(Astro.params.type);
const typeConfig = recsFilters.types[typeKey] || null;

const filteredRecs = allRecs
  .filter((rec) => (rec.frontmatter.type || '').toLowerCase() === typeKey)
  .map((rec) => ({
    ...rec,
    genre: rec.frontmatter.genre || 'General',
    dateValue: new Date(rec.frontmatter.date || '1970-01-01').getTime(),
  }))
  .sort((a, b) => b.dateValue - a.dateValue);

const hasFilters = Array.isArray(typeConfig?.genres) && typeConfig.genres.length > 1;
const genreOptions = typeConfig?.genres || ['All'];
---

<BaseLayout
  title={`${typeConfig?.label || 'Recommendations'} — Anatomy of Becoming`}
  description={`Explore ${typeConfig?.label?.toLowerCase() || 'recommendations'} with genre filters and stacked previews.`}
>
  <section class="container-soft py-section max-w-6xl mx-auto">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between mb-10">
      <div>
        <a href="/recs" class="text-sm uppercase tracking-[0.3em] text-taupe hover:text-espresso transition-colors">← Back to Recs</a>
        <h1 class="font-serif text-4xl text-espresso mt-3">{typeConfig?.label || 'Recommendations'}</h1>
        <p class="text-taupe text-sm max-w-2xl mt-3">
          {typeConfig
            ? `Browse ${typeConfig.label.toLowerCase()} by genre and find the newest recommendations first.`
            : 'This recommendation type is not configured yet.'}
        </p>
      </div>
      <div class="text-right text-sm text-rose/80">{filteredRecs.length} item{filteredRecs.length === 1 ? '' : 's'}</div>
    </div>

    {typeConfig ? (
      <>
        <div class="flex flex-wrap gap-3 mb-10">
          {genreOptions.map((genre) => (
            <button class="genre-filter-btn" data-genre={genre}>{genre}</button>
          ))}
        </div>

        <div class="stack-preview mb-10">
          {filteredRecs.slice(0, 3).map((rec, index) => (
            <div class="stack-card" style={`--stack-index: ${index}`}>
              <span class="stack-label">{rec.frontmatter.title}</span>
            </div>
          ))}
        </div>

        <div id="recs-type-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {filteredRecs.map((rec) => (
            <article class="recs-card group" data-genre={rec.genre}>
              <div class="card-head">
                <div class="h-40 bg-blush/50 flex items-center justify-center overflow-hidden rounded-t-xl">
                  {rec.frontmatter.image ? (
                    <img src={rec.frontmatter.image} alt={rec.frontmatter.title} class="w-full h-full object-cover" />
                  ) : (
                    <span class="text-5xl">{typeConfig.label === 'Books' ? '📖' : typeConfig.label === 'Movies' ? '🎬' : typeConfig.label === 'Podcasts' ? '🎙️' : typeConfig.label === 'Quotes' ? '💬' : '📝'}</span>
                  )}
                </div>
              </div>

              <div class="p-6">
                <span class="text-xs uppercase tracking-[0.3em] text-taupe font-sans">{rec.genre} · {rec.frontmatter.category || 'Uncategorized'}</span>
                <h2 class="font-serif text-xl text-espresso mt-2 mb-2">{rec.frontmatter.title}</h2>
                <p class="text-sm text-taupe leading-relaxed mb-4">{rec.frontmatter.description}</p>
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="text-xs uppercase tracking-[0.3em] text-rose/80">{rec.frontmatter.date}</span>
                  <span class="text-xs text-taupe">{rec.frontmatter.rating}/10</span>
                </div>
                <a href="#" class="btn-secondary btn-small">See more</a>
              </div>
            </article>
          ))}
        </div>

        {!filteredRecs.length && (
          <div class="rounded-soft border border-dashed border-taupe/30 bg-ivory p-8 text-center text-taupe">
            <p class="text-lg font-medium">No {typeConfig.label.toLowerCase()} found yet.</p>
            <p class="mt-2">Add recommendations and assign them to this type to populate the page.</p>
          </div>
        )}
      </>
    ) : (
      <div class="rounded-soft border border-dashed border-taupe/30 bg-ivory p-8 text-center text-taupe">
        <p class="text-lg font-medium">Recommendation type not configured.</p>
        <p class="mt-2">Open <code>src/data/recsFilters.json</code> to add a page and genre filters for this type.</p>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('.genre-filter-btn');
  const cards = document.querySelectorAll('#recs-type-grid .recs-card');

  function applyGenreFilter(selectedGenre) {
    cards.forEach((card) => {
      const genre = card.dataset.genre || 'General';
      card.style.display = selectedGenre === 'All' || genre === selectedGenre ? '' : 'none';
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');
      applyGenreFilter(button.dataset.genre);
    });
  });

  if (buttons.length) {
    buttons[0].classList.add('active');
    applyGenreFilter(buttons[0].dataset.genre);
  }
</script>

<style>
  .genre-filter-btn,
  .btn-secondary.btn-small {
    transition: all 0.25s ease;
  }

  .genre-filter-btn {
    padding: 0.7rem 1.2rem;
    border-radius: 9999px;
    border: 1px solid #DCCFCB;
    background: transparent;
    color: #4A3734;
    font-size: 0.85rem;
    text-transform: uppercase;
    cursor: pointer;
  }

  .genre-filter-btn.active,
  .genre-filter-btn:hover {
    background: #6D5350;
    color: #F7F2EF;
    border-color: #6D5350;
  }

  .stack-preview {
    position: relative;
    min-height: 6rem;
  }

  .stack-card {
    position: absolute;
    top: calc(var(--stack-index) * 0.75rem);
    left: calc(var(--stack-index) * 0.75rem);
    width: calc(100% - var(--stack-index) * 1.5rem);
    padding: 1rem 1.2rem;
    border-radius: 1rem;
    background: #f7eeeb;
    border: 1px solid #dccfcf;
    box-shadow: 0 20px 40px rgba(44, 28, 24, 0.06);
    z-index: calc(10 - var(--stack-index));
    color: #4A3734;
  }

  .stack-card:nth-child(1) { background: #f7eeeb; }
  .stack-card:nth-child(2) { background: #f3e4df; }
  .stack-card:nth-child(3) { background: #efd8d1; }

  .stack-label {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .recs-card {
    border: 1px solid #E7DFDB;
    border-radius: 1.25rem;
    overflow: hidden;
    background: #fff;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .recs-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 36px rgba(44, 28, 24, 0.12);
  }

  .card-head {
    overflow: hidden;
  }

  .btn-secondary.btn-small {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 120px;
    padding: 0.7rem 1rem;
    border-radius: 9999px;
    background: #6d5350;
    color: #f7f2ef;
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
  }

  .btn-secondary.btn-small:hover {
    transform: translateY(-1px);
    background: #553f3c;
  }

  .btn-secondary.btn-small:focus-visible {
    outline: 2px solid #d8b5ad;
    outline-offset: 3px;
  }
</style>
