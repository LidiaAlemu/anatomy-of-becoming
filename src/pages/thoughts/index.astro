---
import BaseLayout from '../../layouts/BaseLayout.astro';

const fragments = [
  "Some goodbyes happen inside you long before they happen out loud.",
  "Healing is not always light. Sometimes it is simply choosing not to abandon yourself.",
  "I am still learning that rest is not a reward. It is part of being human.",
  "Becoming means grieving versions of you that once kept you safe.",
  "There are days when surviving quietly is the bravest thing you do."
];
---

<BaseLayout
  title="Thoughts — Anatomy of Becoming"
  description="Short emotional fragments, intimate reflections, and thoughts never said out loud."
>
  <section class="container-soft py-section max-w-4xl mx-auto">
    <h1 class="font-serif text-display text-espresso mb-3 text-center">
      <span class="handwriting text-5xl md:text-6xl block mb-2">thoughts i never said</span>
    </h1>
    <p class="section-subtitle max-w-2xl mx-auto">
      Soft, unfinished sentences from the quiet rooms of becoming.
    </p>

    <div class="mt-12 space-y-5">
      {fragments.map((fragment) => (
        <article class="card p-7 md:p-8 max-w-3xl mx-auto">
          <p class="text-espresso/85 text-lg md:text-xl italic leading-relaxed">“{fragment}”</p>
        </article>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/stories" class="btn-secondary">Read Longer Stories</a>
    </div>
  </section>
</BaseLayout>
