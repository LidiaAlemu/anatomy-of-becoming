---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThoughtCard from '../../components/ThoughtCard.astro';

const posts = await Astro.glob('../../content/blog/*.md');
const sortedPosts = posts
  .sort((a, b) => new Date(b.frontmatter.date || '').getTime() - new Date(a.frontmatter.date || '').getTime());
---

<BaseLayout
  title="Thoughts — Anatomy of Becoming"
  description="Short emotional fragments, intimate reflections, and thoughts never said out loud."
>
  <section class="container-soft py-section max-w-6xl mx-auto">
    <div class="text-center mb-10">
      <h1 class="font-serif text-display text-espresso mb-3">
        <span class="handwriting text-5xl md:text-6xl block mb-2">thoughts i never said</span>
      </h1>
      <div class="mt-4">
        <a href="/admin/#/collections/blog/new" class="btn-primary inline-block text-sm">Add Story</a>
      </div>
      <p class="section-subtitle max-w-2xl mx-auto">
        Short emotional reflections, rendered honestly and quietly.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {sortedPosts.map((post) => (
        <ThoughtCard
          title={post.frontmatter.title}
          excerpt={post.frontmatter.excerpt}
          slug={post.frontmatter.slug}
          image={post.frontmatter.image}
          category={post.frontmatter.category}
          date={post.frontmatter.date}
        />
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="/stories" class="btn-secondary">Read Longer Stories</a>
    </div>
  </section>
</BaseLayout>
