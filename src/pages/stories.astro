---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThoughtCard from '../components/ThoughtCard.astro';
import genresData from '../data/genres.json';

const posts = await Astro.glob('../content/blog/*.md');
const stories = posts
  .sort((a, b) => new Date(b.frontmatter.date || '').getTime() - new Date(a.frontmatter.date || '').getTime());
const categories = genresData.genres;
---

<BaseLayout
  title="Stories — Anatomy of Becoming"
  description="Long-form reflections on healing, identity, womanhood, faith, grief, and transformation."
>
  <section class="container-soft py-section">
    <div class="text-center mb-10">
      <h1 class="font-serif text-display text-espresso mb-3">
        <span class="handwriting text-5xl md:text-6xl block mb-2">stories</span>
      </h1>
      <div class="mt-4">
        <a href="/admin/#/collections/blog/new" class="btn-primary inline-block text-sm">Add Story</a>
      </div>
      <p class="section-subtitle max-w-2xl mx-auto">
        Longer pieces shaped by the themes that hold this site together.
      </p>
    </div>

    <div class="flex flex-wrap gap-3 justify-center mb-10">
      {categories.map((category) => (
        <span class="px-4 py-2 rounded-full bg-rose/10 text-rose text-xs uppercase tracking-[0.25em] font-sans">
          {category}
        </span>
      ))}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 mt-4">
      {stories.map((post) => (
        <ThoughtCard
          title={post.frontmatter.title}
          excerpt={post.frontmatter.excerpt}
          slug={post.frontmatter.slug}
          image={post.frontmatter.image}
          category={post.frontmatter.category}
          date={post.frontmatter.date}
        />
      ))}
    </div>
  </section>
</BaseLayout>
