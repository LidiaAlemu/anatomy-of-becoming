---
import BaseLayout from '../layouts/BaseLayout.astro';

const cusdisAppId = "your-cusdis-app-id";                // ← paste your real App ID here
const formspreeEndpoint = "https://formspree.io/f/xdajlrpe";   // already set

const stories = [
  { id: 1, text: "I stayed in a relationship long after I knew it was hurting me. I was more afraid of being alone than I was of losing myself.", initial: "A" },
  { id: 2, text: "I come from a family where love was conditional. I'm still learning that I'm allowed to take up space.", initial: "M" },
  { id: 3, text: "Everyone saw me as the strong one. No one noticed how heavy everything was on the inside.", initial: "K" }
];
---

<BaseLayout
  title="Shared Thoughts — Anatomy of Becoming"
  description="A safe space for anonymous stories. Share what's on your heart."
>
  <section class="container-soft py-section max-w-4xl mx-auto">
    <h1 class="font-serif text-display text-espresso mb-4 text-center">
      <span class="handwriting text-5xl md:text-6xl block mb-2">stories from other hearts</span>
    </h1>
    <p class="section-subtitle">
      A space for the thoughts people never said out loud.
      Anonymous stories, real people, raw and unfiltered.
    </p>

    <div class="divider"></div>

    <!-- Submission Form -->
    <div class="card p-8 md:p-12 mb-16">
      <h2 class="font-serif text-2xl text-espresso mb-6 text-center">Share Your Story</h2>
      <form action={formspreeEndpoint} method="POST" class="space-y-6">
        <div>
          <label class="block text-taupe text-sm font-sans mb-2">Your Story</label>
          <textarea
            name="story"
            rows="6"
            placeholder="Write what's on your heart. Everything shared is anonymous."
            required
            class="w-full px-5 py-3 rounded-soft bg-ivory border border-softborder text-espresso placeholder:text-taupe/50 focus:outline-none focus:border-rose/50 font-sans text-sm resize-y"
          ></textarea>
        </div>
        <div class="text-center">
          <button type="submit" class="btn-primary">Share Anonymously</button>
        </div>
      </form>
      <p class="text-xs text-taupe/60 text-center mt-4 font-sans">
        Your story will be shared anonymously. No names or identifying information will be published.
      </p>
    </div>

    <!-- Stories Cards with Cusdis Comments -->
    <div class="space-y-12">
      {stories.map((story) => (
        <div id={`story-${story.id}`}>
          <div class="card p-6 md:p-8 flex items-start gap-5">
            <div class="w-12 h-12 rounded-full bg-rose/20 flex items-center justify-center flex-shrink-0">
              <span class="font-serif text-rose text-xl">{story.initial}</span>
            </div>
            <p class="text-espresso/80 italic text-base leading-relaxed">“{story.text}”</p>
          </div>

          <!-- Cusdis comment thread (anonymous, no sign-in) -->
          <div class="mt-4 ml-6 cusdis-wrapper">
            <div
              id={`cusdis_thread_${story.id}`}
              data-host="https://cusdis.com"
              data-app-id={cusdisAppId}
              data-page-id={`story-${story.id}`}
              data-page-url={`${new URL(Astro.url.pathname, Astro.url.origin).href}#story-${story.id}`}
              data-page-title={`Story ${story.id} — Anatomy of Becoming`}
            ></div>
            <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* Soft Cusdis theme matching your brand */
  .cusdis-wrapper {
    --cusdis-bg: #F7F2EF;
    --cusdis-text: #4A3734;
    --cusdis-border: #EADDD7;
    --cusdis-primary: #C9A7A0;
    --cusdis-primary-hover: #B8958A;
    --cusdis-muted: #8E7B75;
    --cusdis-radius: 0.75rem;
    --cusdis-font: 'Montserrat', sans-serif;
  }
  .cusdis-wrapper iframe {
    border: none !important;
    background: transparent !important;
  }
  .cusdis-powered-by {
    display: none;
  }
</style>