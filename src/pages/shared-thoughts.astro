---
import BaseLayout from '../layouts/BaseLayout.astro';

const cusdisAppId = "10d1bb87-b0b2-4431-9ee1-90a65bd646a8";
const formspreeEndpoint = "https://formspree.io/f/xdajlrpe";

import genres from '../data/genres.json';

// Construct the base URL for the current page (used in Cusdis page-url)
const baseUrl = Astro.url.origin + Astro.url.pathname;
---

<BaseLayout
  title="Shared Thoughts — Anatomy of Becoming"
  description="A safe space for anonymous stories. Share what's on your heart."
>
  <section class="container-soft py-section max-w-4xl mx-auto">
    <h1 class="font-serif text-display text-espresso mb-4 text-center">
      <span class="handwriting text-5xl md:text-6xl block mb-2">stories from other hearts</span>
    </h1>
    <p class="section-subtitle">
      A space for the thoughts people never said out loud.
      Anonymous stories, real people, raw and unfiltered.
    </p>

    <div class="divider"></div>

    <!-- Submission Form -->
    <div class="card p-8 md:p-12 mb-16">
      <h2 class="font-serif text-2xl text-espresso mb-6 text-center">Share Your Story</h2>
      <form action={formspreeEndpoint} method="POST" class="space-y-6">
        <input type="hidden" name="_subject" value="New shared thought from Anatomy of Becoming" />
        <div class="grid gap-6 md:grid-cols-[1fr_1fr]">
          <div>
            <label class="block text-taupe text-sm font-sans mb-2">Title (optional)</label>
            <input type="text" name="title" placeholder="Short title" class="w-full px-5 py-3 rounded-soft bg-ivory border border-softborder text-espresso placeholder:text-taupe/50 focus:outline-none focus:border-rose/50 font-sans text-sm" />
          </div>
          <div>
            <label class="block text-taupe text-sm font-sans mb-2">Name (optional)</label>
            <input type="text" name="name" placeholder="Your name or leave blank" class="w-full px-5 py-3 rounded-soft bg-ivory border border-softborder text-espresso placeholder:text-taupe/50 focus:outline-none focus:border-rose/50 font-sans text-sm" />
          </div>
        </div>

        <div>
          <label class="block text-taupe text-sm font-sans mb-2">Your Story</label>
          <textarea
            name="story"
            rows="6"
            placeholder="Write the thought or story you want to share."
            required
            class="w-full px-5 py-3 rounded-soft bg-ivory border border-softborder text-espresso placeholder:text-taupe/50 focus:outline-none focus:border-rose/50 font-sans text-sm resize-y"
          ></textarea>
        </div>

        <div class="grid gap-6 md:grid-cols-[1fr_1fr]">
          <div>
            <label class="block text-taupe text-sm font-sans mb-2">Emotional Category</label>
            <select name="category" required class="w-full px-5 py-3 rounded-soft bg-ivory border border-softborder text-espresso focus:outline-none focus:border-rose/50 font-sans text-sm">
              <option value="">Choose a category</option>
              {genres.map(g => (
                <option value={g}>{g}</option>
              ))}
            </select>
          </div>
          <div class="flex items-end gap-3">
            <label class="flex items-center gap-3 bg-ivory rounded-soft px-4 py-3 border border-softborder w-full cursor-pointer">
              <input type="checkbox" name="anonymous" value="yes" checked class="accent-rose" />
              <span class="text-sm text-espresso font-sans">Submit anonymously</span>
            </label>
          </div>
        </div>

        <div class="text-center">
          <button type="submit" class="btn-primary">Send softly</button>
        </div>
      </form>
      <p class="text-xs text-taupe/60 text-center mt-4 font-sans">
        Your story will be shared anonymously. No names or identifying information will be published.
      </p>
    </div>

    <!-- Cusdis thread for shared thoughts (page-level) -->
    <div class="card p-6 mt-8">
      <div
        id="cusdis_thread_shared"
        data-host="https://cusdis.com"
        data-app-id={cusdisAppId}
        data-page-id={`shared-thoughts`}
        data-page-url={`${baseUrl}#shared-thoughts`}
        data-page-title={`Shared Thoughts — Anatomy of Becoming`}
      ></div>
    </div>
  </section>
</BaseLayout>

<!-- Cusdis script, loaded once -->
<script async defer src="https://cusdis.com/js/cusdis.es.js"></script>

<style>
  /* Soft Cusdis theme matching brand */
  .cusdis-wrapper {
    --cusdis-bg: #F7F2EF;
    --cusdis-text: #4A3734;
    --cusdis-border: #EADDD7;
    --cusdis-primary: #C9A7A0;
    --cusdis-primary-hover: #B8958A;
    --cusdis-muted: #8E7B75;
    --cusdis-radius: 0.75rem;
    --cusdis-font: 'Montserrat', sans-serif;
  }
  .cusdis-wrapper iframe {
    border: none !important;
    background: transparent !important;
  }
  .cusdis-powered-by {
    display: none;
  }
</style>