---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import LatestThoughts from '../components/LatestThoughts.astro';
import SharedThoughts from '../components/SharedThoughts.astro';
import LittleThings from '../components/LittleThings.astro';
import Newsletter from '../components/Newsletter.astro';
---

<BaseLayout 
  title="Anatomy of Becoming — thoughts i never said"
  description="A soft editorial-style healing blog about identity, womanhood, grief, and becoming. Thoughts on healing, toxic love, medicine, faith, and rebuilding yourself."
>
  <HeroSection />
  <LatestThoughts />
  <SharedThoughts />
  <LittleThings />
  
  <!-- Med School Diaries Section -->
  <section id="med-school" class="container-soft py-section">
    <div class="card p-10 md:p-16 text-center max-w-3xl mx-auto">
      <span class="text-5xl block mb-4">🩺</span>
      <h2 class="font-serif text-subheading text-espresso mb-4">Med School Diaries</h2>
      <p class="text-taupe text-base leading-relaxed mb-6 max-w-xl mx-auto">
        A deeply personal space about medicine, burnout, identity loss, leaving, 
        ambition, grief, and starting over. 
        <span class="italic">This is what survival looked like.</span>
      </p>
      <a href="#" class="btn-secondary">Coming Soon</a>
    </div>
  </section>

  <Newsletter />
</BaseLayout>