---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Fragment } from 'astro/components';
import genresData from '../data/genres.json';

const allRecs = await Astro.glob('../content/recs/*.md');
const genres = genresData.genres;
---

<BaseLayout
  title="Recommendations — Anatomy of Becoming"
  description="Books, playlists, films, and podcasts that comfort, heal, and inspire."
>
  <section class="container-soft py-section max-w-6xl mx-auto">
    <h1 class="font-serif text-display text-espresso mb-4 text-center">
      <span class="handwriting text-5xl md:text-6xl block mb-2">Little Things That Help</span>
    </h1>
    <p class="section-subtitle">Soft recommendations for hard seasons.</p>

    {allRecs.length === 0 && (
      <p class="text-center text-taupe">No recommendations yet. Add some through the CMS!</p>
    )}

    <!-- Filter Controls -->
    <div class="flex flex-wrap justify-center gap-4 mb-10">
      <button class="btn-filter active" data-type="all">All</button>
      <button class="btn-filter" data-type="book">Books</button>
      <button class="btn-filter" data-type="playlist">Playlists</button>
      <button class="btn-filter" data-type="film">Films</button>
      <button class="btn-filter" data-type="podcast">Podcasts</button>

      <select id="genre-filter" class="px-4 py-2 rounded-soft border border-softborder bg-ivory text-espresso font-sans text-sm">
        <option value="all">All Genres</option>
        {genres.map(genre => (
          <option value={genre}>{genre}</option>
        ))}
      </select>
    </div>

    <!-- Cards Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8" id="recs-grid">
      {allRecs.map(rec => (
        <div class="rec-card card overflow-hidden" data-type={rec.frontmatter.type} data-category={rec.frontmatter.category || 'Uncategorized'}>
          <div class="h-48 bg-blush/50 flex items-center justify-center overflow-hidden">
            {rec.frontmatter.image ? (
              <img src={rec.frontmatter.image} alt={rec.frontmatter.title} class="w-full h-full object-cover" />
            ) : (
              <span class="text-4xl">
                {rec.frontmatter.type === 'book' ? '📖' : rec.frontmatter.type === 'playlist' ? '🎧' : rec.frontmatter.type === 'film' ? '🎬' : '🎙️'}
              </span>
            )}
          </div>
          <div class="p-6">
            <span class="text-xs font-sans tracking-widest uppercase text-rose font-medium">
              {rec.frontmatter.type} · {rec.frontmatter.category || 'Uncategorized'}
            </span>
            <h3 class="font-serif text-xl text-espresso mt-2 mb-1">{rec.frontmatter.title}</h3>
            <p class="text-taupe text-sm leading-relaxed mb-3">{rec.frontmatter.description}</p>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs text-taupe font-sans">Rating:</span>
              <div class="flex gap-0.5 text-amber-500">
                {Array.from({ length: 5 }, (_, i) => (
                  <span>{i < Math.round(rec.frontmatter.rating / 2) ? '★' : '☆'}</span>
                ))}
              </div>
              <span class="text-xs text-taupe font-sans">{rec.frontmatter.rating}/10</span>
            </div>
            <div class="prose-soft text-sm mt-4">
              <Fragment set:html={rec.compiledContent()} />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const filterButtons = document.querySelectorAll('.btn-filter');
  const genreSelect = document.getElementById('genre-filter');
  const cards = document.querySelectorAll('.rec-card');

  function filterCards() {
    const activeType = document.querySelector('.btn-filter.active')?.dataset.type || 'all';
    const activeGenre = genreSelect.value;

    cards.forEach(card => {
      const type = card.dataset.type;
      const category = card.dataset.category;
      const typeMatch = activeType === 'all' || type === activeType;
      const genreMatch = activeGenre === 'all' || category === activeGenre;
      card.style.display = typeMatch && genreMatch ? '' : 'none';
    });
  }

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterCards();
    });
  });

  genreSelect.addEventListener('change', filterCards);
</script>

<style>
  .btn-filter {
    padding: 0.5rem 1.5rem;
    border-radius: 2rem;
    border: 1px solid #DCCFCB;
    background: transparent;
    color: #4A3734;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .btn-filter:hover {
    background: #C9A7A0;
    color: #F7F2EF;
  }
  .btn-filter.active {
    background: #6D5350;
    color: #F7F2EF;
    border-color: #6D5350;
  }
</style>