---
import ThoughtCard from './ThoughtCard.astro';

const allPosts = await Astro.glob('../content/blog/*.md');
const latestPosts = allPosts
  .map(p => ({
    title: p.frontmatter.title,
    excerpt: p.frontmatter.excerpt,
    slug: p.frontmatter.slug,
    category: p.frontmatter.category,
    date: p.frontmatter.date
  }))
  .sort((a, b) => new Date(b.date || '').getTime() - new Date(a.date || '').getTime())
  .slice(0, 3);
---

<section id="thoughts" class="container-soft py-section">
    <h2 class="section-title">Latest Thoughts</h2>
  <p class="section-subtitle">Words from the quiet places between healing and becoming.</p>

  <div class="grid lg:grid-cols-3 gap-8 lg:gap-10">
      <div class="lg:col-span-2 grid md:grid-cols-2 gap-8">
      {latestPosts.map((post) => (
        <ThoughtCard 
          title={post.title} 
          excerpt={post.excerpt} 
          slug={post.slug} 
          category={post.category} 
          date={post.date} 
        />
      ))}
    </div>

    <!-- Side Panel: Weekly Notes -->
        <!-- Side Panel: Weekly Notes -->
    <aside class="lg:col-span-1">
      <div class="card p-8 sticky top-8">
        <h3 class="font-serif text-xl text-espresso mb-4">This Week, I'm Thinking About</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-taupe text-sm leading-relaxed">
            <span class="text-rose mt-0.5">•</span>
            choosing peace over proving my worth
          </li>
          <li class="flex items-start gap-3 text-taupe text-sm leading-relaxed">
            <span class="text-rose mt-0.5">•</span>
            unlearning the need to always be available
          </li>
          <li class="flex items-start gap-3 text-taupe text-sm leading-relaxed">
            <span class="text-rose mt-0.5">•</span>
            realizing I can start over many times
          </li>
          <li class="flex items-start gap-3 text-taupe text-sm leading-relaxed">
            <span class="text-rose mt-0.5">•</span>
            romanticizing my healing era
          </li>
        </ul>
        <div class="mt-8 pt-6 border-t border-softborder/50">
          <p class="handwriting text-xl text-center text-rose/70 mb-4">
            We are always becoming.
          </p>
          <a href="/weekly-notes" class="text-mauve hover:text-espresso font-sans text-xs tracking-wider uppercase font-medium inline-flex items-center justify-center gap-2 w-full">
            Read this week's notes →
          </a>
        </div>
      </div>
    </aside>
  </div>

  <div class="text-center mt-12">
    <a href="/thoughts" class="btn-secondary">View All Thoughts</a>
  </div>
</section>