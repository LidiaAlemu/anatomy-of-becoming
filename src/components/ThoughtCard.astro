---
export interface Props {
  title: string;
  excerpt: string;
  slug: string;
  image?: string;
  category?: string;
  date?: string;
}

const { title, excerpt, slug, image, category, date } = Astro.props;
---

<article class="card overflow-hidden group animate-slide-up">
  <a href={`/thoughts/${slug}`} class="block overflow-hidden">
    {
      image ? (
        <img src={image} alt={title} class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-700" />
      ) : (
        <div class="w-full h-48 bg-gradient-to-br from-blush via-rose/20 to-ivory flex items-center justify-center">
          <span class="text-4xl">📝</span>
        </div>
      )
    }
  </a>
  <div class="p-6">
    {category && (
      <span class="text-xs font-sans tracking-widest uppercase text-rose font-medium mb-2 block">
        {category}
      </span>
    )}
    <a href={`/thoughts/${slug}`}>
      <h3 class="font-serif text-xl md:text-2xl text-espresso group-hover:text-mauve transition-colors leading-snug mb-3 text-balance">
        {title}
      </h3>
    </a>
    <p class="text-taupe text-sm leading-relaxed font-light line-clamp-3 mb-4">
      {excerpt}
    </p>
    <a href={`/thoughts/${slug}`} class="text-mauve hover:text-espresso font-sans text-xs tracking-wider uppercase font-medium inline-flex items-center gap-2 group/link">
      Read More
      <span class="group-hover/link:translate-x-1 transition-transform inline-block">→</span>
    </a>
    {date && (
      <p class="text-xs text-taupe/60 mt-3 font-sans">{date}</p>
    )}
  </div>
</article>